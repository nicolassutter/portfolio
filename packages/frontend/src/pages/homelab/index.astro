---
import Layout from '../../layouts/Layout.astro'
import HeroSection from '../../components/HeroSection.vue'
import ArchitectureSection from '../../components/ArchitectureSection.vue'
import ServicesSection from '../../components/ServicesSection.vue'
import LearningSection from '../../components/LearningSection.vue'
import { getHomelabServices, getHomelabData } from '../../modules/content'

const homelabServices = await getHomelabServices()
const homelabData = await getHomelabData()
---

<Layout>
  <main
    role='main'
    class='grid gap-16'
  >
    {/* Hero Section */}
    <HeroSection />

    {/* Architecture Overview */}
    <ArchitectureSection />

    {/* Services I Run */}
    <ServicesSection services={homelabServices} />

    {/* Learning & Documentation */}
    <LearningSection learnings={homelabData.learnings} />
  </main>
</Layout>
