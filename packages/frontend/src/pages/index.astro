---
import Layout from '../layouts/Layout.astro'
import { md } from '../modules/markdown'
import { Image } from 'astro:assets'
import Typography from '../components/Typography.vue'

import Button from '../components/Button.vue'
import { ArrowRight as ArrowRightIcon } from '@lucide/vue'
import { getLatestPosts, getProfile, getTechStacks } from '../modules/requests'
import BlogPost from '../components/BlogPosts.vue'
import StackExplorer from '../components/StackExplorer.vue'

const [posts, profile, techStacks] = await Promise.all([
  getLatestPosts(),
  getProfile(),
  getTechStacks(),
])

const bio = await md.parse(profile.bio ?? '')

export const prerender = false
---

<Layout
  meta={{
    title: profile.name ?? '',
    description: bio,
    image: '/avatar.jpg',
    url: 'https://sutter-nicolas.com/',
  }}
>
  <main
    role='main'
    class=''
  >
    <section class='relative grid items-center gap-10 overflow-hidden rounded-3xl border border-border bg-card p-6 md:p-10 lg:grid-cols-[minmax(0,1fr)_16rem]'>
      <div
        aria-hidden='true'
        class='pointer-events-none absolute inset-0 -z-0 opacity-30 [background-image:linear-gradient(var(--border)_1px,transparent_1px),linear-gradient(90deg,var(--border)_1px,transparent_1px)] [background-size:2rem_2rem]'
      />

      <div class='relative order-2 flex flex-col gap-5 lg:order-1'>
        <div>
          <Typography
            tag='h1'
            class='text-5xl tracking-tight md:text-6xl'
          >
            {profile.name}
          </Typography>
          <p class='mt-3 text-xl font-medium text-primary'>
            I build thoughtful software for the web.
          </p>
        </div>
        <div
          class='text-foreground/85 leading-relaxed'
          set:html={bio}
        />
        <div>
          <Button
            href='/projects'
            as='a'
            variant='primary'
            class='group'
          >
            View projects
            <ArrowRightIcon class='transition-transform group-hover:translate-x-1' />
          </Button>
        </div>
      </div>

      <Image
        src='/avatar.jpg'
        alt={`Portrait of ${profile.name ?? 'Nicolas'}`}
        width={320}
        height={320}
        class='relative order-1 aspect-square w-40 justify-self-center rounded-2xl object-cover shadow-lg md:w-48 lg:order-2 lg:w-52'
        loading='eager'
        decoding='async'
      />
    </section>

    <!-- Skills -->
    <section class='mt-16'>
      <Typography tag='h2'>Stacks I work with:</Typography>

      <div class='mt-6'>
        <StackExplorer {techStacks} />
      </div>
    </section>

    <!-- Latest blog posts -->
    <section class='mt-16'>
      <Typography tag='h2'>Latest blog posts</Typography>
      <Typography>
        Here are some of my latest blog posts. You can find more on my blog
        page.
      </Typography>

      <ul class='grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6'>
        {posts.map((post) => (
          <li>
            <BlogPost
              {post}
              class='h-full'
            />
          </li>
        ))}
      </ul>

      <div class='flex justify-center mt-4'>
        <Button
          href='/blog'
          as='a'
          class='group'
        >
          See all blog posts
          <ArrowRightIcon class='group-hover:ml-2 transition-[margin-left] will-change-[margin-left]' />
        </Button>
      </div>
    </section>
  </main>
</Layout>
