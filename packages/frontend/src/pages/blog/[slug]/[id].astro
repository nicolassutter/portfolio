---
import Layout from '../../../layouts/Layout.astro'
import { md } from '~/src/modules/markdown'
import { getAllPosts, getProfile } from '~/src/modules/content'
import { getPostSlug, getPostUrl } from '~/src/modules/posts'
import Typography from '../../../components/Typography.vue'

export async function getStaticPaths() {
  const posts = await getAllPosts()
  return posts.map((post) => ({
    params: { slug: getPostSlug(post), id: post.id },
    props: { post },
  }))
}

const profile = await getProfile()
const { post } = Astro.props
const content = await md.parse(post.content ?? '')
const url = new URL(`${getPostUrl(post)}/`, Astro.site).href
---

<Layout
  meta={{
    title: post.title,
    description: post.excerpt ?? '',
    image: post.thumbnail,
    url,
    type: 'article',
    publishedTime: post.dateCreated,
    modifiedTime: post.dateUpdated,
  }}
  contentContainerClasses='md:grid-cols-[auto_minmax(0,65ch)_auto]'
>
  <!-- <SkipLinks></SkipLinks> -->
  <header role='banner'>
    {post.thumbnail && (
      <img
        src={post.thumbnail}
        alt=''
        class='rounded-xl w-full mb-8 aspect-video object-cover'
      />
    )}

    <Typography tag='h1'>{post.title}</Typography>
  </header>

  <main
    role='main'
    class='mt-8'
  >
    <div
      class='prose dark:prose-invert prose-img:rounded-xl prose-img:object-cover prose-img:object-center'
      set:html={content}
    />
  </main>
</Layout>
