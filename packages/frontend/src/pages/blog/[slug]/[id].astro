---
import Layout from '../../../layouts/Layout.astro'
import { md } from '~/src/modules/markdown'
import { getAllPosts, getProfile } from '~/src/modules/content'
import Typography from '../../../components/Typography.vue'
import slugify from 'slugify'

export async function getStaticPaths() {
  const posts = await getAllPosts()
  return posts.map((post) => ({
    params: { slug: slugify(post.title, { lower: true }), id: post.id },
    props: { post },
  }))
}

const profile = await getProfile()
const { post } = Astro.props
const content = await md.parse(post.content ?? '')
const url = `https://sutter-nicolas.com/blog/${slugify(post.title, { lower: true })}/${post.id}/`
---

<Layout
  meta={{
    title: profile.name ?? '',
    description: post.excerpt ?? '',
    image: '/avatar.jpg',
    url,
  }}
  contentContainerClasses='md:grid-cols-[auto_minmax(0,65ch)_auto]'
>
  <!-- <SkipLinks></SkipLinks> -->
  <header role='banner'>
    {post.thumbnail && (
      <img
        src={post.thumbnail}
        alt=''
        class='rounded-xl w-full mb-8 aspect-video object-cover'
      />
    )}

    <Typography tag='h1'>{post.title}</Typography>
  </header>

  <main
    role='main'
    class='mt-8'
  >
    <div
      class='prose dark:prose-invert prose-img:rounded-xl prose-img:object-cover prose-img:object-center'
      set:html={content}
    />
  </main>
</Layout>
