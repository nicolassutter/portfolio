---
import Layout from '../../layouts/Layout.astro'
import { md } from '../../modules/markdown'
import Typography from '../../components/Typography.vue'
import { getAllPosts, getProfile } from '../../modules/requests'
import BlogPost from '../../components/BlogPosts.vue'
import BlogPagination from '../../components/BlogPagination.vue'
import { z } from 'zod'

export const prerender = false

const currentPage = z.coerce
  .number()
  .catch(1)
  .parse(Astro.url.searchParams.get('p') ?? '1')
const { posts, total } = await getAllPosts({
  page: currentPage,
})
const profile = await getProfile()
const bio = await md.parse(profile.bio ?? '')
---

<Layout
  meta={{
    title: profile.name ?? '',
    description: bio,
    image: '/avatar.jpg',
    url: 'https://sutter-nicolas.com/',
  }}
>
  <main
    role='main'
    class=''
  >
    <!-- Latest blog posts -->
    <section class=''>
      <Typography tag='h2'>Blog posts</Typography>

      <div class='grid md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6'>
        {posts.map((post) => (
          <BlogPost {post} />
        ))}
      </div>

      <div class='mt-4'>
        <BlogPagination
          count={total}
          page={currentPage}
        />
      </div>
    </section>
  </main>
</Layout>
