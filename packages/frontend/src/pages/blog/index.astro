---
import Layout from '../../layouts/Layout.astro'
import { md } from '../../modules/markdown'
import { getAllPosts, getProfile } from '../../modules/content'
import BlogListing from '../../components/BlogListing.astro'
const allPosts = await getAllPosts()
const posts = allPosts.slice(0, 10)
const profile = await getProfile()
const bio = await md.parse(profile.bio ?? '')
---

<Layout
  meta={{
    title: profile.name ?? '',
    description: bio,
    image: '/avatar.jpg',
    url: new URL(Astro.url.pathname, Astro.site).href,
  }}
>
  <BlogListing
    {posts}
    page={1}
    total={allPosts.length}
  />
</Layout>
