---
import '@fontsource/geist-sans/400.css' // Specify weight
import '@fontsource/geist-sans/500.css' // Specify weight
import '@fontsource/geist-sans/600.css' // Specify weight
import '@fontsource/geist-sans/700.css' // Specify weight

import '../app.css'
import Header from '../components/Header.vue'
import Footer from '../components/Footer.astro'
import { getProfile } from '../modules/content'
import { cn } from '../modules/utils'
import {
  PUBLIC_UMAMI_HOST_URL,
  PUBLIC_UMAMI_WEBSITE_ID,
} from 'astro:env/client'

export interface Props {
  meta?: {
    description?: string
    image?: string
    url?: string
    title: string
    type?: 'article' | 'website'
    publishedTime?: Date
    modifiedTime?: Date
  }
  contentContainerClasses?: string
}

const profile = await getProfile()
const { contentContainerClasses } = Astro.props
const siteUrl = Astro.site ?? Astro.url.origin
const siteHostname = new URL(siteUrl).hostname
const meta = {
  description: profile.bio,
  image: '/avatar.jpg',
  url: siteUrl,
  title: profile.name,
  type: 'website' as const,
  ...(Astro.props.meta ?? {}),
}
const imageUrl = new URL(meta.image, siteUrl).href
---

<!doctype html>
<html
  lang='en'
  class='text-foreground/85 bg-background'
>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width'
    />
    <link
      rel='icon'
      type='image/svg+xml'
      href='/favicon.svg'
    />
    <meta
      name='generator'
      content={Astro.generator}
    />
    <link
      rel='canonical'
      href={meta.url}
    />

    <title>{meta.title}</title>

    <meta
      name='description'
      content={meta.description}
    />
    <meta
      property='og:description'
      content={meta.description}
    />
    <meta
      property='og:image'
      content={imageUrl}
    />
    <meta
      property='og:type'
      content={meta.type}
    />
    <meta
      property='og:url'
      content={meta.url}
    />
    <meta
      property='og:title'
      content={meta.title}
    />
    <meta
      name='twitter:card'
      content='summary_large_image'
    />
    <meta
      name='twitter:title'
      content={meta.title}
    />
    <meta
      name='twitter:description'
      content={meta.description}
    />
    <meta
      name='twitter:image'
      content={imageUrl}
    />
    {meta.publishedTime && (
      <meta
        property='article:published_time'
        content={meta.publishedTime.toISOString()}
      />
    )}
    {meta.modifiedTime && (
      <meta
        property='article:modified_time'
        content={meta.modifiedTime.toISOString()}
      />
    )}

    <!-- does the default theme set up -->
    <script
      is:inline
      src='/theme.vanilla.js'
    ></script>

    <!-- does the reactivity of theme toggle -->
    <script>
      import '../modules/theme'
    </script>

    {PUBLIC_UMAMI_WEBSITE_ID && PUBLIC_UMAMI_HOST_URL && (
      <script
        is:inline
        defer
        src={`${PUBLIC_UMAMI_HOST_URL}/script.js`}
        data-website-id={PUBLIC_UMAMI_WEBSITE_ID}
        data-host-url={PUBLIC_UMAMI_HOST_URL}
        data-domains={`${siteHostname},www.${siteHostname}`}
        data-do-not-track='true'
      ></script>
    )}
  </head>

  <body class='[&_*]:outline-none [&_*]:focus-visible:ring-ring [&_*]:focus-visible:ring-1'>
    <Header client:load />

    <div
      class={cn(
        'grid grid-cols-(--default-content-grid) [:where(&>*)]:col-start-2 pb-10',
        // reserve space for header
        'mt-32',
        contentContainerClasses,
      )}
    >
      <slot />
    </div>

    <Footer {profile} />
  </body>

  <style is:global>
    * {
      min-width: 0;
    }
  </style>
</html>
