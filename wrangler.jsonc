{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sutter-nicolas-com",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./packages/frontend/dist",
    "not_found_handling": "404-page",
  },
  "build": {
    "command": "pnpm build",
    "watch_dir": ["packages/frontend"],
  },
}
